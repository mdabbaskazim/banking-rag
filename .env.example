# ==============================================================================
# Banking RAG - Environment Configuration (.env.example)
# Copy this file to .env and replace placeholders with real credentials.
# Never commit .env or secrets to source control.
# ==============================================================================

# Application Environment (local, test, cloud)
APP_ENV=local
LOG_LEVEL=INFO

# Relational Database (Neon Postgres)
# Direct connection for migrations, checkpointer, worker
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/bankrag?sslmode=require
# Pooled connection (optional) for read-heavy request queries
DATABASE_POOLED_URL=

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://sample-cluster.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_ALIAS=chunks

# Google AI Studio / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_RPM=30
LLM_TPM=16000
LLM_RPD=14400
LLM_TIMEOUT_S=60
LLM_MAX_QUERY_TOKENS=8000
FAKE_LLM=false

# Local Embedding & Entailment Models
EMBED_MODEL=BAAI/bge-m3
HF_HOME=./.cache/hf

# Retrieval & Gate Thresholds
PREFETCH_LIMIT=30
RETRIEVE_K=10
LLM_CONTEXT_K=5
GATE_STRONG=0.75
GATE_WEAK=0.45
HHEM_THRESHOLD=0.75
MAX_VERIFY_RETRIES=2
RISKY_TOPICS=dispute,fraud liability,eligibility
